APP_NAME="ACREST Polytechnique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (recommandé en production). Pour un essai rapide : DB_CONNECTION=sqlite et supprimez les lignes DB_* suivantes.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acrest_polytechnique
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info.acrest@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# --- ACREST Polytechnique -------------------------------------------------
ACREST_EMAIL=info.acrest@gmail.com
ACREST_TELEPHONE="+237 677 86 06 38"
ACREST_FACEBOOK=#

# Frais de préinscription (FCFA) et numéros marchands affichés aux candidats
FRAIS_INSCRIPTION=25000
MTN_MOMO_NUMERO="677 86 06 38"
ORANGE_MONEY_NUMERO=
PAIEMENT_BENEFICIAIRE="ACREST Polytechnique"

# Premier compte administrateur (créé par php artisan db:seed). Changez le mot de passe après la 1re connexion.
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@acrest-polytechnique.cm
ADMIN_PASSWORD=ChangezMoi2026
